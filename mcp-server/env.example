# Copia este archivo como .env dentro de mcp-server/ y completa con tus propios valores.
# NUNCA subas el archivo .env real a Git (ya está excluido en .gitignore).

# Conexión a Odoo (usar el nombre del servicio de Docker, no localhost)
ODOO_URL=http://odoo:8069
ODOO_DB=nombre_de_tu_base_de_datos
ODOO_USER=tu_usuario_admin
ODOO_PASSWORD=tu_contraseña

# API pública de la TRM (Colombia)
TRM_API_URL=https://www.datos.gov.co/resource/32sa-8pi3.json

# Gmail API (archivos generados siguiendo la sección "Obtener credentials.json de Gmail" del README)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
