# Copia este archivo como .env dentro de webapp/ y completa con tus datos.
# NUNCA subas el archivo .env real a Git.

# Tu API key personal de Anthropic (se obtiene en https://console.anthropic.com)
# Esta es distinta a tu cuenta de claude.ai: el uso por API se factura por separado.
ANTHROPIC_API_KEY=sk-ant-tu-api-key-aqui

# Modelo de Claude a usar
ANTHROPIC_MODEL=claude-sonnet-5

# URL del servidor MCP dentro de la red interna de Docker (no cambiar si usas docker-compose)
MCP_SERVER_URL=http://mcp-server:8000/mcp